{
  "name": "api-openapi",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone OpenAPI spec for the Nexus public v3 commerce API",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "test:dash-only-leakage": "node ./scripts/test-dash-only-leakage.mjs",
    "check:dash-only-leakage": "pnpm test:dash-only-leakage && node ./scripts/check-dash-only-leakage.mjs",
    "lint": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint specs/v3/openapi.yaml",
    "build": "node ./scripts/build-json.mjs",
    "build:docs": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly build-docs specs/v3/openapi.yaml --output dist/index.html",
    "build:site": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true node ./scripts/build-site.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.25.1",
    "yaml": "2.8.3"
  }
}
